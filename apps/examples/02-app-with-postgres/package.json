{
  "name": "02-app-with-postgres",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migrations:run": "pnpm run typeorm migration:run -- -d ./src/database/database-migrations.config.ts",
    "migrations:revert": "pnpm run typeorm -- -d ./src/database/database-migrations.config.ts migration:revert",
    "migrations:revert:all": "pnpm run migrations:revert && pnpm run migrations:revert && pnpm run migrations:revert && pnpm run migrations:revert",
    "migrations:fresh": "pnpm run migrations:revert:all; pnpm run migrations:run",
    "db:reset": "docker exec multi-access-postgres-sample psql -U postgres -d multi_acessos -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && pnpm run migrations:run",
    "migrations:create": "cd ./src/database/migrations && npx typeorm migration:create",
    "migrations:show": "pnpm run typeorm -- -d ./src/database/database-migrations.config.ts migration:show",
    "migrations:generate": "pnpm run typeorm -- -d ./src/database/database-migrations.config.ts migration:generate",
    "seed:modules": "ts-node -r tsconfig-paths/register src/database/seeds/seed-modules.ts",
    "seed:companies": "ts-node -r tsconfig-paths/register src/database/seeds/seed-companies.ts",
    "seed:users": "ts-node -r tsconfig-paths/register src/database/seeds/seed-users.ts",
    "seed:access-requests": "ts-node -r tsconfig-paths/register src/database/seeds/seed-access-requests.ts",
    "seed:full": "ts-node -r tsconfig-paths/register src/database/seeds/seed-full.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.4.7",
    "nestjs-rest-query": "workspace:*",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
