@baseUrl = http://localhost:3003

# GET /users — regras em src/users/users.query.ts
#
# Shape da linha: { id, name, email, companyId, company: {...} | null,
#                   posts: [...] }
# As colunas dobradas (nameFolded, emailFolded) são internas e nunca saem.

# ─────────────────────────────────────────────────────────────────────
# PAGINAÇÃO
# ─────────────────────────────────────────────────────────────────────

### Envelope canônico: { data, page, perPage, total, lastPage }
GET {{baseUrl}}/users

### Página explícita
GET {{baseUrl}}/users?page=2&perPage=2

### Sem paginação — devolve só { data }
GET {{baseUrl}}/users?paginate=false

# ─────────────────────────────────────────────────────────────────────
# FILTROS — cada campo declara os operadores que aceita
# ─────────────────────────────────────────────────────────────────────

### id: eq, in
GET {{baseUrl}}/users?filter[id][eq]=1

### id: in
GET {{baseUrl}}/users?filter[id][in]=1,2,3

### name: like (%, _ e \ são LITERAIS)
GET {{baseUrl}}/users?filter[name][like]=Souza

### name: ilike — compara a coluna dobrada, não depende da collation
GET {{baseUrl}}/users?filter[name][ilike]=CARLA

### email: ilike
GET {{baseUrl}}/users?filter[email][ilike]=ACME.TEST

### companyId: isNull
GET {{baseUrl}}/users?filter[companyId][isNull]=true

### createdAt: between (dois valores, exatamente)
GET {{baseUrl}}/users?filter[createdAt][between]=2026-01-01T00:00:00Z,2026-12-31T00:00:00Z

### relação `one` → vira `company: { is: ... }`
GET {{baseUrl}}/users?filter[company.name][eq]=Acme Elétrica

### relação `many` → vira `posts: { some: ... }`; o root não infla
GET {{baseUrl}}/users?filter[posts.title][ilike]=elétrica

# ─────────────────────────────────────────────────────────────────────
# ORDENAÇÃO
# ─────────────────────────────────────────────────────────────────────

### Crescente
GET {{baseUrl}}/users?sort=name

### Decrescente
GET {{baseUrl}}/users?sort=-createdAt

### Múltiplos campos; a PK é anexada como desempate
GET {{baseUrl}}/users?sort=name,-email

### Por coluna de relação `one` (permitido)
GET {{baseUrl}}/users?sort=-company.name

### ✗ 400 — ordenar por coluna de relação `many` não tem semântica definida
GET {{baseUrl}}/users?sort=-posts.title

# ─────────────────────────────────────────────────────────────────────
# BUSCA (declarada em name e email)
# ─────────────────────────────────────────────────────────────────────

### A caixa do termo não muda o conjunto devolvido
GET {{baseUrl}}/users?search=elétrica

### Mesmo total da anterior
GET {{baseUrl}}/users?search=ELÉTRICA

# ─────────────────────────────────────────────────────────────────────
# PROJEÇÃO
# ─────────────────────────────────────────────────────────────────────

### Exatamente os campos pedidos; a PK sai do JSON se não for pedida
GET {{baseUrl}}/users?fields=name,email

### ✗ 400 FIELD_NOT_ALLOWED — createdAt é ordenável, mas não projetável
GET {{baseUrl}}/users?fields=id,createdAt

# ─────────────────────────────────────────────────────────────────────
# INCLUDES
# ─────────────────────────────────────────────────────────────────────

### `one` → objeto ou null, com a projeção default da relação
GET {{baseUrl}}/users?includes=company

### `many` → array, inclusive vazio
GET {{baseUrl}}/users?includes=posts&perPage=2

### fields de relação exige o include correspondente
GET {{baseUrl}}/users?includes=company,posts&fields=id,name,company.name,posts.title

### ✗ 400 — fields=company.name sem includes=company
GET {{baseUrl}}/users?fields=id,company.name

# ─────────────────────────────────────────────────────────────────────
# ERROS ESPERADOS — o corpo traz `code`, não mensagem em string
# ─────────────────────────────────────────────────────────────────────

### ✗ 400 FIELD_NOT_ALLOWED
GET {{baseUrl}}/users?filter[password][eq]=x

### ✗ 400 OPERATOR_NOT_ALLOWED — id declara só eq e in
GET {{baseUrl}}/users?filter[id][gt]=1

### ✗ 400 FILTER_VALUE_INVALID — a v3 coage pelo tipo, não pelo texto
GET {{baseUrl}}/users?filter[id][eq]=10abc

### ✗ 400 FIELD_NOT_ALLOWED — a whitelist da relação é exata
GET {{baseUrl}}/users?includes=posts&fields=id,posts.content
