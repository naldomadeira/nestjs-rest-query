# Database — read by Prisma via DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/app_db_prisma

# Individual vars (used by seed.ts when building DATABASE_URL ad-hoc)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=app_db_prisma
DB_USER=postgres
DB_PASSWORD=postgres

# Server
PORT=3003
NODE_ENV=development
