@baseUrl = http://localhost:3002

# COMPANIES — drizzle adapter
#
# Result row shape (flat, TypeORM-compatible):
#   { id, name, createdAt, users: [...] }

# ─────────────────────────────────────────────────────────────────────
# BASIC
# ─────────────────────────────────────────────────────────────────────

### List all
GET {{baseUrl}}/companies

### Pagination
GET {{baseUrl}}/companies?page=1&perPage=5

### No pagination
GET {{baseUrl}}/companies?paginate=false

# ─────────────────────────────────────────────────────────────────────
# FILTERS — root columns
# ─────────────────────────────────────────────────────────────────────

### Exact
GET {{baseUrl}}/companies?filter[name][eq]=Acme Corp

### ILike
GET {{baseUrl}}/companies?filter[name][ilike]=tech

### Date comparison
GET {{baseUrl}}/companies?filter[createdAt][gte]=2024-01-01

### IN
GET {{baseUrl}}/companies?filter[name][in]=Acme Corp,Globex,Initech

# ─────────────────────────────────────────────────────────────────────
# FILTERS — relation paths (1:N: users)
# ─────────────────────────────────────────────────────────────────────

### Filter companies that have any user matching email
### Adds whereJoin AND activates two-phase pagination
GET {{baseUrl}}/companies?filter[users.email][ilike]=ana

# ─────────────────────────────────────────────────────────────────────
# SORTING
# ─────────────────────────────────────────────────────────────────────

GET {{baseUrl}}/companies?sort=name

GET {{baseUrl}}/companies?sort=-createdAt

### ✗ Sort by 'many' relation column (users) → 400
GET {{baseUrl}}/companies?sort=-users.name

# ─────────────────────────────────────────────────────────────────────
# SEARCH (declared on name)
# ─────────────────────────────────────────────────────────────────────

GET {{baseUrl}}/companies?search=acme

# ─────────────────────────────────────────────────────────────────────
# FIELDS
# ─────────────────────────────────────────────────────────────────────

GET {{baseUrl}}/companies?fields=id,name

# ─────────────────────────────────────────────────────────────────────
# INCLUDES — 1:N (users)
# ─────────────────────────────────────────────────────────────────────

### Two-phase pagination kicks in because `users` is cardinality 'many'
### Result row: { ...companyColumns, users: [...] }
GET {{baseUrl}}/companies?includes=users&page=1&perPage=2

# ─────────────────────────────────────────────────────────────────────
# COMBINATIONS
# ─────────────────────────────────────────────────────────────────────

### Filter + 1:N include + pagination
GET {{baseUrl}}/companies?filter[name][ilike]=acme&includes=users&page=1&perPage=5

### Relation filter + include
GET {{baseUrl}}/companies?filter[users.email][ilike]=acme&includes=users&page=1&perPage=3
