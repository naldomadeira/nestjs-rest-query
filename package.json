{
  "name": "nestjs-rest-query",
  "version": "2.1.0",
  "description": "Declarative, whitelist-first REST query params for NestJS and TypeORM.",
  "keywords": [
    "nestjs",
    "typeorm",
    "rest",
    "query",
    "query-params",
    "filter",
    "filters",
    "pagination",
    "sorting",
    "search",
    "swagger",
    "openapi",
    "whitelist"
  ],
  "scripts": {
    "build": "./scripts/build.sh",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{md,mdx,yml,yaml,json,js,jsx,ts,tsx,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{md,mdx,yml,yaml,json,js,jsx,ts,tsx,mjs,cjs}\"",
    "test": "jest --passWithNoTests --runInBand",
    "test:cov": "jest --coverage --passWithNoTests --runInBand",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "s02:dev": "pnpm --filter 02-app-with-postgres dev",
    "s03:dev": "pnpm --filter 03-app-with-drizzle dev",
    "s04:dev": "pnpm --filter 04-app-with-prisma dev",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:start": "pnpm --filter docs start"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./typeorm": {
      "types": "./dist/infra/adapters/typeorm.adapter.d.ts",
      "require": "./dist/infra/adapters/typeorm.adapter.js"
    },
    "./drizzle": {
      "types": "./dist/infra/adapters/drizzle.adapter.d.ts",
      "require": "./dist/infra/adapters/drizzle.adapter.js"
    },
    "./prisma": {
      "types": "./dist/infra/adapters/prisma.adapter.d.ts",
      "require": "./dist/infra/adapters/prisma.adapter.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "typeorm": [
        "./dist/infra/adapters/typeorm.adapter.d.ts"
      ],
      "drizzle": [
        "./dist/infra/adapters/drizzle.adapter.d.ts"
      ],
      "prisma": [
        "./dist/infra/adapters/prisma.adapter.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://naldomadeira.github.io/nestjs-rest-query/",
  "bugs": {
    "url": "https://github.com/naldomadeira/nestjs-rest-query/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naldomadeira/nestjs-rest-query.git"
  },
  "author": "Naldo Madeira <naldomadeira@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "10.x",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "jest-junit": "^17.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typeorm": "^0.3.26",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "sqlite3"
    ]
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "drizzle-orm": "^0.45.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^0.3.26"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  }
}
