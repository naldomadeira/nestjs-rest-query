{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "rootDir": ".",
    "rootDirs": ["./src", "./test", "./tests"],
    "baseUrl": "./",
    "module": "Node16",
    "target": "ES2022",
    "lib": ["esnext"],
    "alwaysStrict": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "isolatedModules": true,
    "moduleResolution": "node16",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "removeComments": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "jest"],
    "allowJs": false,
    "resolveJsonModule": true,
    "paths": {
      "@src/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@api/*": ["src/api/*"],
      "@domain/*": ["src/domain/*"],
      "@contracts/*": ["src/contracts/*"],
      "@contracts": ["src/contracts/index.ts"],
      "@contracts/v3": ["src/contracts/v3/index.ts"],
      "@domain/handlers": ["src/domain/handlers/index.ts"],
      "@infra/*": ["src/infra/*"],
      "@test/*": ["test/*"]
    }
  },
  "include": ["./src/**/*.ts", "./test/**/*.ts", "./tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
